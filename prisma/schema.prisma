generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Vote {
  id           Int           @id @default(autoincrement())
  date         DateTime      @default(now())
  nom          String        @db.Text
  type         TypeVote
  description  String?       @db.Text
  choix        Choix[]
  possibilites Possibilite[]
  status       StatusVote    @default(INITIAL)
  texte        Texte         @relation(fields: [texteId], references: [id], onDelete: Cascade)
  texteId      Int
}

model Possibilite {
  id     Int    @id @default(autoincrement())
  nom    String
  vote   Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId Int
}

model Choix {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  syndicat   Syndicat @relation(fields: [syndicatId], references: [id])
  syndicatId Int
  vote       Vote     @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId     Int

  choix Json

  @@unique([syndicatId, voteId])
}

model Syndicat {
  id             Int      @id @default(autoincrement())
  nom            String   @unique
  mandats        Mandat[] @relation()
  choix          Choix[]
  defaultMandats Int      @default(0) @db.UnsignedInt
  actif          Boolean  @default(true)
}

model Mandat {
  syndicat    Syndicat  @relation(fields: [syndicatId], references: [id])
  syndicatId  Int
  rencontre   Rencontre @relation(fields: [rencontreId], references: [id])
  rencontreId Int
  mandat      Int       @default(1)

  @@id([syndicatId, rencontreId])
}

model Rencontre {
  id        Int             @id @default(autoincrement())
  nom       String          @default("")
  dateDebut DateTime
  dateFin   DateTime
  type      TypeRencontre
  status    StatusRencontre @default(INITIAL)
  mandats   Mandat[]        @relation()
  textes    Texte[]
}

model Texte {
  id          Int       @id @default(autoincrement())
  titre       String
  votes       Vote[]
  rencontre   Rencontre @relation(fields: [rencontreId], references: [id])
  rencontreId Int
  pdfs        Pdf[]
}

model Pdf {
  id      Int    @id @default(autoincrement())
  nom     String
  titre   String
  texte   Texte  @relation(fields: [texteId], references: [id], onDelete: Cascade)
  texteId Int
}

enum TypeChoix {
  POUR
  CONTRE
  ABSTENTION
  NPPV
}

enum StatusVote {
  INITIAL
  EN_VOTE
  CLOTURE
}

enum TypeRencontre {
  CONGRES
  CF
  BF
  PU
}

enum StatusRencontre {
  INITIAL
  DEMARE
  CLOTURE
}

enum TypeVote {
  STANDARD
  EN_CONTRE
  CONDORCET
}
