generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Vote {
  id           Int           @id @default(autoincrement())
  date         DateTime      @default(now())
  nom          String
  type         TypeVote
  description  String?       @db.Text
  content      String        @default("") @db.Text
  choix        Choix[]
  possibilites Possibilite[]
  rencontre    Rencontre     @relation(fields: [rencontreId], references: [id])
  rencontreId  Int
  status       StatusVote    @default(INITIAL)
}

model Possibilite {
  id     Int    @id @default(autoincrement())
  nom    String
  vote   Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId Int
}

model Choix {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  syndicat   Syndicat @relation(fields: [syndicatId], references: [id])
  syndicatId Int
  vote       Vote     @relation(fields: [voteId], references: [id])
  voteId     Int

  choix Json

  @@unique([syndicatId, voteId])
}

model Syndicat {
  id            Int      @id @default(autoincrement())
  nom           String   @unique
  mandats       Mandat[] @relation()
  choixStandard Choix[]
}

model Mandat {
  syndicat    Syndicat  @relation(fields: [syndicatId], references: [id])
  syndicatId  Int
  rencontre   Rencontre @relation(fields: [rencontreId], references: [id])
  rencontreId Int
  mandat      Int       @default(1)

  @@id([syndicatId, rencontreId])
}

model Rencontre {
  id        Int             @id @default(autoincrement())
  nom       String          @default("")
  dateDebut DateTime
  dateFin   DateTime
  type      TypeRencontre
  status    StatusRencontre @default(INITIAL)
  mandats   Mandat[]        @relation()
  votes     Vote[]
}

enum TypeChoix {
  POUR
  CONTRE
  ABSTENTION
  NPPV
}

enum StatusVote {
  INITIAL
  EN_VOTE
  CLOTURE
}

enum TypeRencontre {
  CONGRES
  CF
  BF
  PU
}

enum StatusRencontre {
  INITIAL
  DEMARE
  CLOTURE
}

enum TypeVote {
  STANDARD
  EN_CONTRE
  CONDORCET
}
